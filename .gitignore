# secrets
.env
.env.*
!.env.example

# dependencies and builds
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv
# In an iCloud-synced checkout the virtualenv can live in .venv.nosync (iCloud
# skips *.nosync names) with .venv as a symlink to it. iCloud otherwise marks
# files under .venv hidden, and Python 3.13+ ignores hidden .pth files.
.venv.nosync/
.pytest_cache/

# data and local databases (everything under /data is generated by `pnpm ingest`)
/data/
*.duckdb
*.duckdb.wal
*.parquet

# OS and editor
.DS_Store
.idea/
.vscode/

# tests and tooling caches
coverage/
.ruff_cache/
.mypy_cache/
*.tsbuildinfo
next-env.d.ts
