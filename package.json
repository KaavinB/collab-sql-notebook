{
  "name": "collab-sql-notebook",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "uv run --directory services/api --env-file ../../.env notebook-api",
    "api": "uv run --directory services/api",
    "lint": "pnpm -r lint && pnpm api ruff check . && pnpm api ruff format --check .",
    "typecheck": "pnpm -r typecheck && pnpm api mypy",
    "test": "pnpm -r test && pnpm test:api",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ingest": "uv run --directory services/api notebook-ingest --data-dir ../../data",
    "db:migrate": "uv run --directory services/api --env-file ../../.env alembic upgrade head",
    "db:revision": "uv run --directory services/api --env-file ../../.env alembic revision --autogenerate -m",
    "test:api": "uv run --directory services/api --env-file ../../.env pytest -q"
  }
}
