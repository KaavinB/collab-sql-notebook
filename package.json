{
  "name": "collab-sql-notebook",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "uv run --directory services/api --env-file ../../.env notebook-api",
    "api": "uv run --directory services/api",
    "lint": "pnpm -r lint && pnpm api ruff check . && pnpm api ruff format --check .",
    "typecheck": "pnpm -r typecheck && pnpm api mypy",
    "test": "pnpm -r test && pnpm api pytest -q",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  }
}
