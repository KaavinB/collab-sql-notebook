# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=notebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notebook
POSTGRES_PORT=5432

# --- API (services/api) ---
# Loaded by `pnpm dev:api`. The API never reads .env files itself.
# Auto-reload on code changes. Dev only.
API_RELOAD=true
API_PORT=8010
# SQLAlchemy URL using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://notebook:change-me@127.0.0.1:5432/notebook
# Comma-separated list of browser origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000
# Host header values the API answers to (blocks DNS rebinding).
API_ALLOWED_HOSTS=127.0.0.1,localhost
# Request body limit (every API body is JSON).
API_MAX_BODY_BYTES=262144
# DuckDB file built by `pnpm ingest`. Relative paths resolve against services/api.
DUCKDB_PATH=../../data/taxi.duckdb
# Query limits (QUERY_TIMEOUT_SECONDS, QUERY_ROW_LIMIT, ...) have defaults in
# services/api/src/notebook_api/config.py; override them here if needed.

# --- Auth (services/api) ---
# The web app's origin (must be in API_CORS_ORIGINS) and this API's URL as the
# browser reaches it. Use "localhost" for both, not 127.0.0.1: the session
# cookie is SameSite=Lax, and localhost vs 127.0.0.1 count as different sites.
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8010
# Signs the short-lived OAuth flow cookie. Generate: openssl rand -hex 32
AUTH_SECRET=
# Plain-HTTP local dev only; leave unset (true) anywhere served over HTTPS.
AUTH_COOKIE_SECURE=false
# Sign in by typing a name, no provider. Local dev and e2e only: the API
# refuses to start with it unless API_HOST, API_ALLOWED_HOSTS, WEB_URL and
# API_PUBLIC_URL are all loopback and AUTH_COOKIE_SECURE=false.
AUTH_DEV_LOGIN=true
# OAuth apps. Callback URLs to register:
#   GitHub: http://localhost:8010/auth/github/callback
#   Google: http://localhost:8010/auth/google/callback
# A provider appears on the sign-in page only when both of its values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Live collaboration: shared by the API and the sync server ---
# Signs the 60-second tickets the API hands browsers for opening a sync
# socket; the API signs, the sync server verifies, so both need the same
# value. At least 32 characters and different from AUTH_SECRET. Leave empty
# to turn live collaboration off (the ticket route answers 503).
# Generate: openssl rand -hex 32
SYNC_TICKET_SECRET=
# The sync server's WebSocket URL as the browser reaches it (ws:// locally,
# wss:// anywhere served over HTTPS). Handed to the browser with each ticket.
SYNC_PUBLIC_URL=ws://localhost:8020

# --- AI assistant (services/api) ---
# Anthropic API key. Leave empty to turn the assistant off (its routes answer
# 503). Only ever sent to the Anthropic API; never logged, never given to the
# query workers.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (default), claude-sonnet-5-5 or claude-opus-5-5.
AI_MODEL=claude-haiku-5-5
# How much the model thinks before answering: low, medium (default) or high.
# Sent on every request, because the models' own defaults differ.
AI_EFFORT=medium
# When the model declines a request, let the API retry it on Anthropic's
# recommended fallback model (Sonnet 5.5 and Opus 5.5 only; Haiku 5.5 has no
# server-side fallback). Default true.
AI_REFUSAL_FALLBACKS=true
# AI requests the API runs at once (per process); past it, new ones are
# refused as busy instead of queued. Each person may also run at most two at
# once. Default 4 (a starting value, not tuned).
AI_MAX_CONCURRENT=4
# Canned, deterministic answers instead of Claude, for e2e tests without a key.
# Same loopback-only rule as AUTH_DEV_LOGIN. Questions containing fake-invalid,
# fake-repair, fake-refuse or fake-slow steer the fake (ai/client.py).
AI_FAKE_MODEL=false

# --- Sync server (apps/sync) ---
# Loaded by `pnpm dev:sync`, which also uses DATABASE_URL above (the sync
# server writes notebook documents to Postgres; Alembic still owns the schema).
SYNC_HOST=127.0.0.1
SYNC_PORT=8020
# Comma-separated browser origins allowed to open a sync socket.
SYNC_ALLOWED_ORIGINS=http://localhost:3000
# apps/sync tests use DATABASE_URL's database name + "_sync_test" (created and
# migrated automatically). Override with a URL whose database ends in _test:
# SYNC_TEST_DATABASE_URL=

# --- Text-to-SQL eval (pnpm eval) ---
# A real (paid) run reads ANTHROPIC_API_KEY, AI_MODEL as the default for
# --models and AI_EFFORT (low, medium or high; medium if unset) as the default
# for --effort: the same variables the API's AI assistant uses. `--dry-run`
# needs no key. The taxi suite reads DUCKDB_PATH (above).

# --- Web (apps/web) ---
# apps/web/next.config.ts loads this root .env file.
NEXT_PUBLIC_API_URL=http://localhost:8010
